{
    "name": "tro365/website",
    "description": "Website thuê trọ Trọ 365 - PHP 8.2 + MySQL",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Tro365 Team",
            "email": "admin@tro365.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "delight-im/auth": "^8.3",
        "filp/whoops": "^2.18",
        "guzzlehttp/guzzle": "^7.9",
        "intervention/image": "^2.7",
        "kevinrob/guzzle-cache-middleware": "^6.0",
        "league/commonmark": "^2.4",
        "league/flysystem": "^3.0",
        "monolog/monolog": "^3.5",
        "nesbot/carbon": "^3.8",
        "phpmailer/phpmailer": "^6.8",
        "rakit/validation": "^1.4",
        "ramsey/uuid": "^4.7",
        "respect/validation": "^2.4",
        "spatie/image-optimizer": "^1.8",
        "symfony/cache": "^7.3",
        "symfony/validator": "^7.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpstan/phpstan": "1.11",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Tro365\\Api\\": "classes/api/",
            "Tro365\\Models\\": "classes/models/",
            "Tro365\\Services\\": "classes/services/",
            "Tro365\\Core\\": "classes/core/",
            "Tro365\\Controllers\\": "classes/controllers/",
            "Tro365\\Assets\\": "classes/assets/",
            "Tro365\\Helpers\\": "classes/helpers/",
            "Tro365\\": "classes/"
        },
        "files": [
            "includes/functions/helpers.php",
            "includes/functions/auth.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tro365\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 classes/",
        "cs-fix": "phpcbf --standard=PSR12 classes/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
