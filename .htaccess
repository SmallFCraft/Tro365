RewriteEngine On

# Prevent access to sensitive files
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<Files "composer.json">
    Order allow,deny
    Deny from all
</Files>

<Files "composer.lock">
    Order allow,deny
    Deny from all
</Files>

# Prevent access to logs directory
RewriteRule ^logs/ - [F,L]

# Prevent access to config files
RewriteRule ^config/ - [F,L]

# Prevent access to classes directory
RewriteRule ^classes/ - [F,L]

# Prevent access to includes directory
RewriteRule ^includes/ - [F,L]

# Handle sitemap.xml, robots.txt, and favicon BEFORE other rules
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^favicon\.ico$ assets/images/logo/favicon.ico [L]

# Allow access to assets
RewriteRule ^assets/ - [L]

# Allow access to vendor (if needed for public assets)
# Note: Disabled by default for security. Uncomment specific asset subpaths only if required.
# RewriteRule ^vendor/some-package/public/ - [L]

# Deny access to common VCS and dotfiles
RedirectMatch 404 /\.git(/|$)
RedirectMatch 404 /\.svn(/|$)
RedirectMatch 404 /\.hg(/|$)
RedirectMatch 404 /\.DS_Store$
RedirectMatch 404 /Thumbs\.db$

# Handle service worker requests (return 404 for non-existent sw.js)
RewriteRule ^sw\.js$ - [R=404,L]

# Main routing - redirect all requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

    # Optional: Strict-Transport-Security (enable only on HTTPS)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Optional: Content-Security-Policy (start with report-only, then enforce)
    # Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"

RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Cache control - Enhanced for performance optimization
<IfModule mod_expires.c>
    ExpiresActive on

    # CSS and JavaScript - 1 year (with versioning)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Images - 1 year (static assets)
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/ico "access plus 1 year"
    ExpiresByType image/icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # Modern image formats - 1 year
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"

    # Fonts - 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Documents - 1 month
    ExpiresByType text/plain "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"

    # HTML - 1 hour (dynamic content)
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Add Cache-Control headers for better performance
<IfModule mod_headers.c>
    # Cache static assets for 1 year
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Cache HTML for 1 hour
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
