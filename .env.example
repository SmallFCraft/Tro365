# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Tro365
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Application Configuration
APP_NAME="Trọ 365"
APP_URL=https://tro.loading99.site
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Security
APP_KEY=your-secret-key-here
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tro.loading99.site
MAIL_FROM_NAME="Trọ 365"

# Upload Configuration
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
UPLOAD_PATH=assets/uploads/

# Commission Configuration
COMMISSION_RATE=5.0

# Pagination
POSTS_PER_PAGE=20
ADMIN_POSTS_PER_PAGE=50

# Cache
CACHE_ENABLED=true
CACHE_LIFETIME=3600

# Logging
LOG_LEVEL=info
LOG_PATH=logs/

# Social Media
FACEBOOK_URL=https://facebook.com/tro365
ZALO_URL=https://zalo.me/tro365
YOUTUBE_URL=
INSTAGRAM_URL=

# Contact Information
COMPANY_NAME="Công ty TNHH Trọ 365"
COMPANY_ADDRESS="Hà Nội, Việt Nam"
COMPANY_PHONE=1900xxxx
COMPANY_EMAIL=contact@tro.loading99.site
HOTLINE=1900xxxx
